# Copy to .env and fill in real values. Never commit .env - see docs/security-baseline.md §4.

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=csc
DB_USER=csc
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# docs/security-baseline.md OD-007 - default matches PMS's current value (7 days);
# reconsider before production given crash-evidence sensitivity.
ACCESS_TOKEN_LIFETIME_DAYS=7

# Phase 1 audio ingestion (docs/phase1-audio-ingestion.md, docs/open-decisions.md
# OD-010) - interim defaults, both configurable per deployment.
AUDIO_MAX_UPLOAD_SIZE_BYTES=104857600
PRIVATE_STORAGE_ROOT=private_storage

# Phase 2 - Sarvam Speech-to-Text (docs/phase2-sarvam-stt.md). Get a key from the
# Sarvam Dashboard (https://dashboard.sarvam.ai). Backend-only - never sent to a
# client, never logged, never committed.
SARVAM_API_KEY=
SARVAM_HTTP_TIMEOUT_SECONDS=60
SARVAM_POLL_INTERVAL_SECONDS=5
SARVAM_POLL_TIMEOUT_SECONDS=600

# Phase 4 - Gemini eDAR extraction (docs/phase4-gemini-edar-extraction.md). Get a
# key from Google AI Studio (https://aistudio.google.com/apikey). Backend-only -
# never sent to a client, never logged, never committed.
GEMINI_API_KEY=
GEMINI_HTTP_TIMEOUT_SECONDS=120
